# -------- 服务配置信息 --------
APP_ENV=prod
APP_NAME=FastApi学习
APP_PORT=8088
APP_HOST=0.0.0.0
APP_VERSION=v1.0.0
APP_DEBUG=true

# -------- jwt配置 --------
# 是否开启jwt
JWT_ENABLE=false
# 秘钥
JWT_SECRET_KEY=abcd12345@abcdef
# 算法
JWT_ALGORITHM=HS256
# 过期时间(单位:分钟)
JWT_EXPIRED=60
# 签发人
JWT_ISS=猿码记
# 不校验JWT token的路由
JWT_NO_CHECK_URIS=/,/apidoc,/openapi.json,/api/user/login,/favicon.ico


# -------- 数据库配置 --------
DB_DSN=mysql+pymysql://root:root@127.0.0.1:3306/test # 数据库连接
DB_ECHO_SQL=True # 使用打印SQL日志信息
DB_POOL_SIZE=5  # 连接池中的初始连接数，默认为 5
DB_MAX_OVERFLOW=10  # 连接池中允许的最大超出连接数

# -------- redis配置 --------
REDIS_DSN=redis://0.0.0.0:6379/0

# -------- 日志配置 --------
LOG_FILE=./logs/app.log
LOG_LEVEL=DEBUG
LOG_SERIALIZE=False # 是否序列化成 JSON
LOG_COMPRESSION=zip # 日志压缩（zip, tar, gz 等）
LOG_ROTATION=00:00 # 日志轮转（按大小、时间、函数）; 大小:500MB, 时间:00:00（每天零点新建文件）
LOG_RETENTION=7 # 日志保留策略，多久自动删;保留7d
LOG_FORMAT= "{time:YYYY-MM-DD HH:mm:ss} | {level} | {extra[trace_id]} | {file}{function}:{line} | {message}" # 格式
